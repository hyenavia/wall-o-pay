        allow update: if isOwner(uid) && areImmutableFieldsUnchanged(['id']) && isValidDebtPayment(request.resource.data, docId);
        allow delete: if isOwner(uid);
      }

      // Transaction Templates (camelCase and legacy snake_case)
      match /txTemplates/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidTxTemplate(request.resource.data, docId);
        allow update: if isOwner(uid) && areImmutableFieldsUnchanged(['id']) && isValidTxTemplate(request.resource.data, docId);
        allow delete: if isOwner(uid);
      }

      match /tx_templates/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidTxTemplate(request.resource.data, docId);
        allow update: if isOwner(uid) && areImmutableFieldsUnchanged(['id']) && isValidTxTemplate(request.resource.data, docId);
        allow delete: if isOwner(uid);
      }

      // Pending Transactions (camelCase and legacy snake_case)
      match /pendingTransactions/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidPendingTransaction(request.resource.data, docId);
        allow update: if isOwner(uid) && areImmutableFieldsUnchanged(['id']) && isValidPendingTransaction(request.resource.data, docId);

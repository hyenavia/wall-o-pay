        allow create: if isOwner(uid) && isValidSavingsGoal(request.resource.data, docId);
        allow update: if isOwner(uid) && areImmutableFieldsUnchanged(['id']) && isValidSavingsGoal(request.resource.data, docId);
        allow delete: if isOwner(uid);
      }

      // Recurring Rules (camelCase and legacy snake_case)
      match /recurringRules/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidRecurringRule(request.resource.data, docId);
        allow update: if isOwner(uid) && areImmutableFieldsUnchanged(['id']) && isValidRecurringRule(request.resource.data, docId);
        allow delete: if isOwner(uid);
      }

      match /recurring_rules/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidRecurringRule(request.resource.data, docId);
        allow update: if isOwner(uid) && areImmutableFieldsUnchanged(['id']) && isValidRecurringRule(request.resource.data, docId);
        allow delete: if isOwner(uid);
      }

      // Debts
      match /debts/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidDebt(request.resource.data, docId);
        allow update: if isOwner(uid) && areImmutableFieldsUnchanged(['id']) && isValidDebt(request.resource.data, docId);
        allow delete: if isOwner(uid);
      }

      // Debt Payments (camelCase and legacy snake_case)
      match /debtPayments/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidDebtPayment(request.resource.data, docId);
        allow update: if isOwner(uid) && areImmutableFieldsUnchanged(['id']) && isValidDebtPayment(request.resource.data, docId);
        allow delete: if isOwner(uid);
      }

      match /debt_payments/{docId} {
        allow read: if isOwner(uid);

<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#38D5E8DC">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="@color/widget_card_glass_start"
                        android:endColor="@color/widget_card_glass_end" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/widget_rim_glass" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

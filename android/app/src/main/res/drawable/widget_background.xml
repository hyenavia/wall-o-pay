<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. HeroCard Emerald-to-Moss Diagonal Base Gradient (matches HeroCard) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/widget_hero_start"
                android:centerColor="@color/widget_hero_mid"
                android:endColor="@color/widget_hero_end" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 2. Botanical Emerald Aurora Radial Glow Top-Right (matches BotanicalHeroCardPainter) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.88"
                android:centerY="0.10"
                android:gradientRadius="220dp"
                android:startColor="@color/widget_aurora_glow"
                android:endColor="#0010251F" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 3. Specular Diagonal Glass Glare Sheen (matches _ProfileCardGlassPainter) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/widget_sheen_top"
                android:centerColor="@color/widget_sheen_mid"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 4. Crisp Dew Mint Specular Glass Border (28% alpha, 1.2dp) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/widget_rim_hero" />
        </shape>
    </item>
</layer-list>

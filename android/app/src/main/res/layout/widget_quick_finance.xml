<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <!-- Subtle Enchanted Glasshouse Botanical Canopy & Conservatory Mullions -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:layout_gravity="top|end"
        android:scaleType="fitXY"
        android:src="@drawable/widget_botanical_canopy"
        android:importantForAccessibility="no" />

    <!-- Subtle Understory Leaves & Growth Contour Bottom-Left -->
    <ImageView
        android:layout_width="130dp"
        android:layout_height="84dp"
        android:layout_gravity="bottom|start"
        android:scaleType="fitXY"
        android:src="@drawable/widget_botanical_corner"
        android:importantForAccessibility="no" />

    <!-- Foreground Interactive Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="@string/widget_title"
                android:textColor="@color/widget_soft_ivory"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_balance_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/widget_balance_pill_bg"
                android:text="@string/widget_balance_hidden"
                android:textColor="@color/widget_dew_mint"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <FrameLayout
                android:id="@+id/widget_open_app"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_circle_glass_btn">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_open_app"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>
        </LinearLayout>

        <!-- Feedback Banner (shown on save / validation feedback) -->
        <TextView
            android:id="@+id/widget_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/widget_success_bg"
            android:textColor="@color/widget_income_on_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Segmented Tab Selector Track (matches Material 3 SegmentedButton) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="3dp"
            android:background="@drawable/widget_segmented_bar_bg"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/tab_income"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="@drawable/widget_tab_bg_inactive">

                <ImageView
                    android:id="@+id/tab_income_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_widget_income_off"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tab_income_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_income"
                    android:textColor="@color/widget_fresh_sage"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_expense"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="@drawable/widget_tab_bg_expense">

                <ImageView
                    android:id="@+id/tab_expense_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_widget_expense_on"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tab_expense_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_expense"
                    android:textColor="@color/widget_soft_ivory"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_transfer"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="@drawable/widget_tab_bg_inactive">

                <ImageView
                    android:id="@+id/tab_transfer_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_widget_transfer_off"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tab_transfer_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_transfer"
                    android:textColor="@color/widget_fresh_sage"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Flexible Upper Cushion (expands only when extra launcher height exists) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.45" />

        <!-- Dynamic Quick Form Glass Card (matches AppCard) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/widget_card_inner">

            <!-- Nominal Display Row (Tap to open QuickTransactionActivity keypad/note) -->
            <LinearLayout
                android:id="@+id/widget_nominal_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_queued_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nominal"
                    android:textColor="@color/widget_fresh_sage"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_queued_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:text="Rp 0"
                    android:textColor="@color/widget_expense_on_dark"
                    android:textSize="18.5sp"
                    android:textStyle="bold"
                    android:fontFeatureSettings="tnum"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <FrameLayout
                    android:id="@+id/btn_clear_amount"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_chip_bg"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_widget_close"
                        android:contentDescription="Clear" />
                </FrameLayout>
            </LinearLayout>

            <!-- Subtle Conservatory Hairline Divider -->
            <FrameLayout
                android:id="@+id/widget_card_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="6dp"
                android:background="@color/widget_divider_hairline" />

            <!-- Dynamic Context Selector Row (Category & Account OR From -> To) -->
            <LinearLayout
                android:id="@+id/context_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/chip_category"
                    android:layout_width="0dp"
                    android:layout_height="27dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/widget_chip_bg">

                    <ImageView
                        android:id="@+id/chip_category_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_widget_category"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/chip_category_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category"
                        android:textColor="@color/widget_soft_ivory"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chip_wallet_from"
                    android:layout_width="0dp"
                    android:layout_height="27dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/widget_chip_bg">

                    <ImageView
                        android:id="@+id/chip_wallet_from_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_widget_wallet"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/chip_wallet_from_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Main Account"
                        android:textColor="@color/widget_dew_mint"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/transfer_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="→"
                    android:textColor="@color/widget_transfer_on_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/chip_wallet_to"
                    android:layout_width="0dp"
                    android:layout_height="27dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/widget_chip_bg"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/chip_wallet_to_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_widget_wallet"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/chip_wallet_to_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Digital Bank"
                        android:textColor="@color/widget_dew_mint"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Preset Chips Row (matches _QuickAmountChip) -->
        <LinearLayout
            android:id="@+id/presets_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/btn_preset_10k"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_quick_chip_bg"
                android:gravity="center"
                android:text="+10k"
                android:textColor="@color/widget_dew_mint"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btn_preset_20k"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_quick_chip_bg"
                android:gravity="center"
                android:text="+20k"
                android:textColor="@color/widget_dew_mint"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btn_preset_50k"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_quick_chip_bg"
                android:gravity="center"
                android:text="+50k"
                android:textColor="@color/widget_dew_mint"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btn_preset_100k"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="@drawable/widget_quick_chip_bg"
                android:gravity="center"
                android:text="+100k"
                android:textColor="@color/widget_dew_mint"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Flexible Lower Cushion (keeps CTA anchored cleanly near bottom rim on taller layouts) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.55" />

        <!-- Bottom Action Buttons Row (matches TransactionForm secondary + primary CTA) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/btn_detail"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:background="@drawable/widget_btn_secondary">

                <ImageView
                    android:id="@+id/btn_detail_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_widget_edit"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/btn_detail_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_detail"
                    android:textColor="@color/widget_dew_mint"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_record"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1.8"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/widget_btn_record">

                <ImageView
                    android:id="@+id/btn_record_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_widget_check"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/btn_record_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_record"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

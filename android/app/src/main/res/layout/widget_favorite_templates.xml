<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fav_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <!-- Subtle Enchanted Glasshouse Botanical Canopy -->
    <ImageView
        android:layout_width="135dp"
        android:layout_height="88dp"
        android:layout_gravity="top|end"
        android:scaleType="fitXY"
        android:src="@drawable/widget_botanical_canopy"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="110dp"
        android:layout_height="68dp"
        android:layout_gravity="bottom|start"
        android:scaleType="fitXY"
        android:src="@drawable/widget_botanical_corner"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Header Row (hidden in ultra-compact 4x1 or when feedback banner is visible in 4x1) -->
        <LinearLayout
            android:id="@+id/fav_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/fav_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/fav_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/widget_favorites_title"
                android:textColor="@color/widget_soft_ivory"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <FrameLayout
                android:id="@+id/fav_btn_privacy"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_circle_glass_btn">

                <ImageView
                    android:id="@+id/fav_btn_privacy_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_eye_on"
                    android:contentDescription="Toggle privacy" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fav_btn_add"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_circle_glass_btn">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_plus"
                    android:contentDescription="@string/shortcut_expense_short" />
            </FrameLayout>
        </LinearLayout>

        <!-- Feedback & Undo Banner (shown right after one-tap record) -->
        <LinearLayout
            android:id="@+id/fav_feedback_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_success_bg"
            android:visibility="gone">

            <TextView
                android:id="@+id/fav_feedback_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/widget_soft_ivory"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/fav_btn_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_pill_caution"
                android:text="@string/widget_undo"
                android:textColor="@color/widget_warning_on_dark"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <ImageView
                android:id="@+id/fav_btn_dismiss_feedback"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:padding="3dp"
                android:src="@drawable/ic_widget_close"
                android:contentDescription="Dismiss" />
        </LinearLayout>

        <!-- Empty State Card (when no templates saved yet) -->
        <LinearLayout
            android:id="@+id/fav_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/widget_card_inner"
            android:visibility="gone">

            <TextView
                android:id="@+id/fav_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_favorites_empty"
                android:textColor="@color/widget_soft_ivory"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/fav_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_favorites_empty_hint"
                android:textColor="@color/widget_fresh_sage"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 2x2 Favorite Template Tiles Grid -->
        <LinearLayout
            android:id="@+id/fav_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: Slot 0 & Slot 1 -->
            <LinearLayout
                android:id="@+id/fav_row_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/fav_slot_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/widget_template_tile_bg">

                    <TextView
                        android:id="@+id/fav_slot_0_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_soft_ivory"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/fav_slot_0_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/widget_expense_on_dark"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fav_slot_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/widget_template_tile_bg">

                    <TextView
                        android:id="@+id/fav_slot_1_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_soft_ivory"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/fav_slot_1_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/widget_expense_on_dark"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Slot 2 & Slot 3 (collapsed to GONE in 4x1) -->
            <LinearLayout
                android:id="@+id/fav_row_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/fav_slot_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/widget_template_tile_bg">

                    <TextView
                        android:id="@+id/fav_slot_2_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_soft_ivory"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/fav_slot_2_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/widget_expense_on_dark"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fav_slot_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/widget_template_tile_bg">

                    <TextView
                        android:id="@+id/fav_slot_3_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_soft_ivory"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/fav_slot_3_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/widget_expense_on_dark"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>


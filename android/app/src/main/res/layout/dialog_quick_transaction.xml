<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/dialog_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:clipToOutline="true"
            android:background="@drawable/widget_dialog_bg">

            <!-- Subtle Botanical Canopy Ornament Top-Right -->
            <ImageView
                android:layout_width="150dp"
                android:layout_height="100dp"
                android:layout_gravity="top|end"
                android:scaleType="fitXY"
                android:src="@drawable/widget_botanical_canopy"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="@string/app_name" />

                    <TextView
                        android:id="@+id/dialog_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/widget_title"
                        android:textColor="@color/widget_soft_ivory"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:fontFamily="sans-serif-medium" />

                    <FrameLayout
                        android:id="@+id/dialog_btn_close"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/widget_circle_glass_btn">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_widget_close"
                            android:contentDescription="Close" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 3-Tab Unified Segmented Transaction Type Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/widget_segmented_bar_bg"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:id="@+id/dialog_tab_income"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:background="@drawable/widget_tab_bg_inactive">

                        <ImageView
                            android:id="@+id/dialog_tab_income_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_widget_income_off"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/dialog_tab_income_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_income"
                            android:textColor="@color/widget_fresh_sage"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dialog_tab_expense"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:background="@drawable/widget_tab_bg_expense">

                        <ImageView
                            android:id="@+id/dialog_tab_expense_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_widget_expense_on"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/dialog_tab_expense_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_expense"
                            android:textColor="@color/widget_soft_ivory"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dialog_tab_transfer"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:background="@drawable/widget_tab_bg_inactive">

                        <ImageView
                            android:id="@+id/dialog_tab_transfer_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_widget_transfer_off"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/dialog_tab_transfer_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_transfer"
                            android:textColor="@color/widget_fresh_sage"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Amount Input -->
                <TextView
                    android:id="@+id/dialog_label_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nominal"
                    android:textColor="@color/widget_fresh_sage"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/widget_input_glass">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp "
                        android:textColor="@color/widget_dew_mint"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif-medium" />

                    <EditText
                        android:id="@+id/dialog_input_amount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="0"
                        android:textColorHint="@color/widget_hint_text"
                        android:textColor="@color/widget_soft_ivory"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="number"
                        android:digits="0123456789."
                        android:maxLength="17"
                        android:imeOptions="actionNext" />
                </LinearLayout>

                <!-- Category Section (visible for Income & Expense) -->
                <LinearLayout
                    android:id="@+id/dialog_category_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/dialog_label_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category"
                        android:textColor="@color/widget_fresh_sage"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="4dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/widget_input_glass">

                        <Spinner
                            android:id="@+id/dialog_spinner_category"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:backgroundTint="@color/widget_fresh_sage"
                            android:popupBackground="@color/widget_surface_container" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Source / Primary Wallet Section -->
                <TextView
                    android:id="@+id/dialog_label_wallet_from"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account"
                    android:textColor="@color/widget_fresh_sage"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/widget_input_glass">

                    <Spinner
                        android:id="@+id/dialog_spinner_wallet_from"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:backgroundTint="@color/widget_fresh_sage"
                        android:popupBackground="@color/widget_surface_container" />
                </FrameLayout>

                <!-- Destination Wallet Section (visible for Transfer) -->
                <LinearLayout
                    android:id="@+id/dialog_wallet_to_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/dialog_label_wallet_to"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination Account"
                        android:textColor="@color/widget_fresh_sage"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="4dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/widget_input_glass">

                        <Spinner
                            android:id="@+id/dialog_spinner_wallet_to"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:backgroundTint="@color/widget_fresh_sage"
                            android:popupBackground="@color/widget_surface_container" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Note Input -->
                <TextView
                    android:id="@+id/dialog_label_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description (Optional)"
                    android:textColor="@color/widget_fresh_sage"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/dialog_input_note"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/widget_input_glass"
                    android:hint="e.g. Lunch, monthly allowance"
                    android:textColorHint="@color/widget_hint_text"
                    android:textColor="@color/widget_soft_ivory"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:imeOptions="actionDone" />

                <!-- Validation Error Message -->
                <TextView
                    android:id="@+id/dialog_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:padding="10dp"
                    android:background="@drawable/widget_error_bg"
                    android:textColor="@color/widget_expense_on_dark"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:visibility="gone" />

                <!-- Save Button (matches TransactionForm semantic gradient CTA) -->
                <LinearLayout
                    android:id="@+id/dialog_btn_save"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/widget_btn_record">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_widget_check"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/dialog_btn_save_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_record"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
